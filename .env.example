# 本地开发环境变量（可选）。不填则用内置开发默认值（仅本地演示，请勿用于生产）。
# 复制为 .env 并填写；node 服务端通过 process.env 读取。

# Postgres 连接串（本地安装后创建）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scriptengine

# 用于签发登录 JWT（生产务必改成随机长串）
JWT_SECRET=change-me-to-random

# 用于加密用户 DeepSeek Key（生产务必改成随机长串）
API_KEY_SECRET=change-me-to-random

# 后端监听端口（dev 时前端代理会指向它）
PORT=3001

# DeepSeek 接口地址（一般无需改）
DEEPSEEK_BASE=https://api.deepseek.com

# 管理员账户（启动时自动创建；留空则不创建）。登录可用 用户名 或 邮箱。
# 注意：这是模板，请勿把真实密码提交到仓库；真实值写在本地 .env（已被 .gitignore 忽略）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
